%% hust-override.sty -- chỉnh nhỏ cho theme HUST mà KHÔNG sửa slides/hust-theme/ (nạp trong main.tex sau \usetheme).
%% Bỏ dải tên các phần (Mở đầu, Khảo sát, ...) ở đầu mỗi slide, giữ thanh tiêu đề, nhãn mục ở góc và một thanh tiến độ mảnh
%% (độ dài = số slide đã qua / tổng số slide). Theme không có tuỳ chọn riêng cho việc này (progressbar=off bỏ luôn cả thanh tiến độ).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{hust-override}[2026/11/21 thanh tien do manh thay dai ten cac phan]
\makeatletter
\def\hust@prog@h{3pt}   % cao 3 pt thay vì 0,058 chiều cao trang (khoảng 14,8 pt)
\renewcommand{\hust@render@progressbar}{%
  \fill[hustgrayline!30] (current page.north west) rectangle ([yshift=-\hust@prog@h] current page.north east);
  \ifnum\inserttotalframenumber>0\relax
    \ifnum\insertframenumber>\inserttotalframenumber \setlength{\hust@sec@w}{\paperwidth}\else \setlength{\hust@sec@w}{\dimexpr\paperwidth * \insertframenumber / \inserttotalframenumber\relax}\fi%
    \fill[hustmain] (current page.north west) rectangle ([xshift=\hust@sec@w, yshift=-\hust@prog@h] current page.north west);
  \fi
}
% P12d: noi dung len sat thanh tieu de (do tren PDF bang scripts/do_vung_slide.py)
\newlength\TieuDeLen
\setlength\TieuDeLen{17pt}
\addtobeamertemplate{frametitle}{}{\vskip-\TieuDeLen}
\newlength\ThemVung
\setlength\ThemVung{14pt}  % vung noi dung duoc phep dai den sat duong ke chan trang (y = 236,6 pt); do tren PDF
\g@addto@macro\beamer@calculateheadfoot{\advance\textheight by \ThemVung \@colht\textheight \@colroom\textheight \vsize\textheight}
\makeatother
\endinput
