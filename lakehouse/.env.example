# Copy to .env and fill in. Never commit .env.
# Ports on the Windows host (127.0.0.1 only). PostgreSQL of the warehouse stays on 5432; the Lakehouse source PostgreSQL uses 5433.
LH_PG_PORT=5433
LH_PG_USER=olist
LH_PG_PASSWORD=change-me
LH_PG_DB=olist_src
LH_CATALOG_DB=iceberg_catalog
LH_MINIO_USER=lakehouse
LH_MINIO_PASSWORD=change-me-too-8chars
LH_MINIO_BUCKET=lakehouse
LH_MINIO_PORT=9000
LH_MINIO_CONSOLE_PORT=9001
LH_CONNECT_PORT=8083
LH_REST_PORT=8181
LH_TRINO_PORT=8080
LH_SUPERSET_PORT=8088
LH_SUPERSET_SECRET_KEY=change-me-long-random-string
LH_SUPERSET_ADMIN_PASSWORD=change-me
