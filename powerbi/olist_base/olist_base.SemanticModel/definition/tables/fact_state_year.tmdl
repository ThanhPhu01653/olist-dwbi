/// Fact periodic snapshot: 1 bang × 1 năm (dân số và PIB từ IBGE; GMV, đơn, khách, seller của Olist) – dashboard D8
table fact_state_year

	column year_date_key
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: year_date_key

	column state_code
		dataType: string
		sourceColumn: state_code

	column state_name
		dataType: string
		sourceColumn: state_name

	column region
		dataType: string
		sourceColumn: region

	column population
		dataType: int64
		formatString: #,0
		sourceColumn: population

	column gdp_thousand_brl
		dataType: double
		sourceColumn: gdp_thousand_brl

	column gmv
		dataType: decimal
		formatString: "#,0.00"
		sourceColumn: gmv

	column orders
		dataType: int64
		formatString: #,0
		sourceColumn: orders

	column customers
		dataType: int64
		formatString: #,0
		sourceColumn: customers

	column sellers
		dataType: int64
		formatString: #,0
		sourceColumn: sellers

	column etl_batch_id
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: etl_batch_id

	partition fact_state_year = m
		mode: import
		source =
				let
				    Source = fnCsv("fact_state_year.csv", {
				            {"year_date_key", Int64.Type}, {"state_code", type text}, {"state_name", type text}, {"region", type text},
				            {"population", Int64.Type}, {"gdp_thousand_brl", type number}, {"gmv", Currency.Type}, {"orders", Int64.Type},
				            {"customers", Int64.Type}, {"sellers", Int64.Type}, {"etl_batch_id", Int64.Type}
				        })
				in
				    Source

	annotation PBI_ResultType = Table
