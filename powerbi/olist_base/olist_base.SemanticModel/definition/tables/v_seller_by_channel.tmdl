/// Mart: seller và GMV theo kênh thu hút
table v_seller_by_channel

	column acquisition_channel
		dataType: string
		sourceColumn: acquisition_channel

	column sellers
		dataType: int64
		formatString: #,0
		sourceColumn: sellers

	column selling_sellers
		dataType: int64
		formatString: #,0
		sourceColumn: selling_sellers

	column pct_selling
		dataType: double
		sourceColumn: pct_selling

	column orders
		dataType: double
		sourceColumn: orders

	column gmv
		dataType: decimal
		formatString: "#,0.00"
		sourceColumn: gmv

	column gmv_per_selling_seller
		dataType: decimal
		formatString: "#,0.00"
		sourceColumn: gmv_per_selling_seller

	column late_rate_pct
		dataType: double
		sourceColumn: late_rate_pct

	column avg_review_score
		dataType: double
		sourceColumn: avg_review_score

	column small_sample
		dataType: boolean
		sourceColumn: small_sample

	partition v_seller_by_channel = m
		mode: import
		source =
				let
				    Source = fnCsv("v_seller_by_channel.csv", {
				            {"acquisition_channel", type text}, {"sellers", Int64.Type}, {"selling_sellers", Int64.Type}, {"pct_selling", type number},
				            {"orders", type number}, {"gmv", Currency.Type}, {"gmv_per_selling_seller", Currency.Type}, {"late_rate_pct", type number},
				            {"avg_review_score", type number}, {"small_sample", type logical}
				        })
				in
				    Source

	annotation PBI_ResultType = Table
