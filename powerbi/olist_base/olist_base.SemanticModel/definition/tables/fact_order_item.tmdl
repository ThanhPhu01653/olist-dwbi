/// Fact giao dịch: 1 dòng hàng của 1 đơn
table fact_order_item

	column order_id
		dataType: string
		summarizeBy: none
		sourceColumn: order_id

	column order_item_id
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: order_item_id

	column purchase_date_key
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: purchase_date_key

	column shipping_limit_date_key
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: shipping_limit_date_key

	column customer_key
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: customer_key

	column customer_geography_key
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: customer_geography_key

	column seller_geography_key
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: seller_geography_key

	column seller_key
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: seller_key

	column product_key
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: product_key

	column order_status_key
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: order_status_key

	column price
		dataType: decimal
		formatString: "#,0.00"
		sourceColumn: price

	column freight_value
		dataType: decimal
		formatString: "#,0.00"
		sourceColumn: freight_value

	column item_total
		dataType: decimal
		formatString: "#,0.00"
		sourceColumn: item_total

	column etl_batch_id
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: etl_batch_id

	partition fact_order_item = m
		mode: import
		source =
				let
				    Source = fnCsv("fact_order_item.csv", {
				            {"order_id", type text}, {"order_item_id", Int64.Type}, {"purchase_date_key", Int64.Type}, {"shipping_limit_date_key", Int64.Type},
				            {"customer_key", Int64.Type}, {"customer_geography_key", Int64.Type}, {"seller_geography_key", Int64.Type}, {"seller_key", Int64.Type},
				            {"product_key", Int64.Type}, {"order_status_key", Int64.Type}, {"price", Currency.Type}, {"freight_value", Currency.Type},
				            {"item_total", Currency.Type}, {"etl_batch_id", Int64.Type}
				        })
				in
				    Source

	annotation PBI_ResultType = Table
