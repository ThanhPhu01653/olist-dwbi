/// Mart: GMV, đơn, AOV theo ngày (chỉ đơn không Failed)
table v_sales_daily

	column date_key
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: date_key

	column full_date
		dataType: dateTime
		formatString: yyyy-MM-dd
		sourceColumn: full_date

		annotation UnderlyingDateTimeDataType = Date

	column year
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: year

	column quarter
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: quarter

	column year_month
		dataType: string
		sourceColumn: year_month

	column is_weekend
		dataType: boolean
		sourceColumn: is_weekend

	column is_holiday_br
		dataType: boolean
		sourceColumn: is_holiday_br

	column is_black_friday
		dataType: boolean
		sourceColumn: is_black_friday

	column in_window
		dataType: boolean
		sourceColumn: in_window

	column orders
		dataType: int64
		formatString: #,0
		sourceColumn: orders

	column items
		dataType: int64
		formatString: #,0
		sourceColumn: items

	column gmv
		dataType: decimal
		formatString: "#,0.00"
		sourceColumn: gmv

	column freight
		dataType: decimal
		formatString: "#,0.00"
		sourceColumn: freight

	column aov
		dataType: decimal
		formatString: "#,0.00"
		sourceColumn: aov

	partition v_sales_daily = m
		mode: import
		source =
				let
				    Source = fnCsv("v_sales_daily.csv", {
				            {"date_key", Int64.Type}, {"full_date", type date}, {"year", Int64.Type}, {"quarter", Int64.Type},
				            {"year_month", type text}, {"is_weekend", type logical}, {"is_holiday_br", type logical}, {"is_black_friday", type logical},
				            {"in_window", type logical}, {"orders", Int64.Type}, {"items", Int64.Type}, {"gmv", Currency.Type},
				            {"freight", Currency.Type}, {"aov", Currency.Type}
				        })
				in
				    Source

	annotation PBI_ResultType = Table
