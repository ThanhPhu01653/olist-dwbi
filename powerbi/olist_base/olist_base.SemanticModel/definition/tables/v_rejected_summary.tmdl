/// Số dòng bị loại theo lô, job, lý do (mục 3.3 ETL)
table v_rejected_summary

	column batch_id
		dataType: int64
		formatString: #,0
		sourceColumn: batch_id

	column job_name
		dataType: string
		sourceColumn: job_name

	column source_table
		dataType: string
		sourceColumn: source_table

	column reason
		dataType: string
		sourceColumn: reason

	column row_count
		dataType: int64
		formatString: #,0
		sourceColumn: row_count

	column last_logged_at
		dataType: dateTime
		formatString: yyyy-MM-dd HH:mm:ss
		sourceColumn: last_logged_at

	partition v_rejected_summary = m
		mode: import
		source =
				let
				    Source = fnCsv("v_rejected_summary.csv", {
				            {"batch_id", Int64.Type}, {"job_name", type text}, {"source_table", type text}, {"reason", type text},
				            {"row_count", Int64.Type}, {"last_logged_at", type text}
				        }),
				    Fixed = Table.TransformColumns(Source, {{"last_logged_at", each try DateTime.FromText(Text.Start(_, 19)) otherwise null, type nullable datetime}})
				in
				    Fixed

	annotation PBI_ResultType = Table
