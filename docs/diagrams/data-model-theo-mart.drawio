&#10;3. Vùng nào đóng góp nhiều nhất, vùng nào tăng nhanh nhất?&#10;4. AOV và tăng trưởng MoM, YoY?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4B5563;fontSize=11;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="830" height="180" as="geometry"/></mxCell><mxCell id="c18" value="mart_fulfillment" style="rounded=0;verticalAlign=top;align=left;spacingLeft=8;dashed=1;whiteSpace=wrap;html=1;fillColor=#FFFBEA;strokeColor=#4B5563;fontSize=13;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="910" y="60" width="870" height="500" as="geometry"/></mxCell><mxCell id="c19" value="fact_order_fulfillment&#10;Xử lý đơn · snapshot tích luỹ&#10;1 đơn, 5 mốc thời gian" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4A261;strokeColor=#4B5563;fontSize=11;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="930" y="100" width="300" height="66" as="geometry"/></mxCell><mxCell id="c20" value="dim_date" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8ECAE6;strokeColor=#4B5563;fontSize=11;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="1360" y="100" width="400" height="30" as="geometry"/></mxCell><mxCell id="c21" value="dim_geography" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8ECAE6;strokeColor=#4B5563;fontSize=11;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="1360" y="138" width="400" height="30" as="geometry"/></mxCell><mxCell id="c22" value="dim_customer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8ECAE6;strokeColor=#4B5563;fontSize=11;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="1360" y="176" width="400" height="30" as="geometry"/></mxCell><mxCell id="c23" value="dim_order_status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8ECAE6;strokeColor=#4B5563;fontSize=11;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="1360" y="214" width="400" height="30" as="geometry"/></mxCell><mxCell id="e24" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#6B7280;strokeWidth=1.0;" edge="1" parent="1" source="c19" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e25" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#6B7280;strokeWidth=1.0;" edge="1" parent="1" source="c19" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e26" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#6B7280;strokeWidth=1.0;" edge="1" parent="1" source="c19" target="c22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e27" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#6B7280;strokeWidth=1.0;" edge="1" parent="1" source="c19" target="c23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="Câu hỏi phân tích:&#10;1. Chặng nào (duyệt, bàn giao, vận chuyển) mất lâu nhất?&#10;2. Bang nào giao trễ nhiều nhất?&#10;3. Ngày hứa giao so với giao thực tế chênh bao nhiêu?&#10;4. Khoảng cách seller đến khách ảnh hưởng lead time thế nào?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4B5563;fontSize=11;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="930" y="360" width="830" height="180" as="geometry"/></mxCell><mxCell id="c29" value="mart_cx" style="rounded=0;verticalAlign=top;align=left;spacingLeft=8;dashed=1;whiteSpace=wrap;html=1;fillColor=#FFFBEA;strokeColor=#4B5563;fontSize=13;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="580" width="870" height="500" as="geometry"/></mxCell><mxCell id="c30" value="fact_review&#10;Đánh giá · transaction&#10;1 review của 1 đơn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4A261;strokeColor=#4B5563;fontSize=11;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="300" height="66" as="geometry"/></mxCell><mxCell id="c31" value="fact_payment&#10;Thanh toán · transaction&#10;1 lần thanh toán" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4A261;strokeColor=#4B5563;fontSize