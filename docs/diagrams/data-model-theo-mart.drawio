<mxfile host="app.diagrams.net"><diagram name="Data model theo data mart" id="d1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1800" pageHeight="1130"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Data mart: mỗi mart gồm fact (cam), các dimension (xanh) và 3–4 câu hỏi phân tích" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=16;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1750" height="34" as="geometry"/></mxCell><mxCell id="c3" value="mart_sales" style="rounded=0;verticalAlign=top;align=left;spacingLeft=8;dashed=1;whiteSpace=wrap;html=1;fillColor=#FFFBEA;strokeColor=#4B5563;fontSize=13;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="870" height="500" as="geometry"/></mxCell><mxCell id="c4" value="fact_order_item&#10;Bán hàng · transaction&#10;1 dòng hàng của 1 đơn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4A261;strokeColor=#4B5563;fontSize=11;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="300" height="66" as="geometry"/></mxCell><mxCell id="c5" value="dim_geography" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8ECAE6;strokeColor=#4B5563;fontSize=11;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="470" y="100" width="400" height="30" as="geometry"/></mxCell><mxCell id="c6" value="dim_customer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8ECAE6;strokeColor=#4B5563;fontSize=11;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="470" y="138" width="400" height="30" as="geometry"/></mxCell><mxCell id="c7" value="dim_order_status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8ECAE6;strokeColor=#4B5563;fontSize=11;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="470" y="176" width="400" height="30" as="geometry"/></mxCell><mxCell id="c8" value="dim_product" style="rounded=1;whiteSpace=wrap;html=1;fillColo