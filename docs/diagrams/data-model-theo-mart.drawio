số kỳ trả góp?&#10;3. Bao nhiêu khách quay lại mua (RFM, cohort)?&#10;4. Tỷ lệ review tiêu cực theo tháng và vùng?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4B5563;fontSize=11;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="830" height="180" as="geometry"/></mxCell><mxCell id="c41" value="mart_acquisition" style="rounded=0;verticalAlign=top;align=left;spacingLeft=8;dashed=1;whiteSpace=wrap;html=1;fillColor=#FFFBEA;strokeColor=#4B5563;fontSize=13;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="910" y="580" width="870" height="500" as="geometry"/></mxCell><mxCell id="c42" value="fact_lead_funnel&#10;Thu hút seller · snapshot tích luỹ&#10;1 khách tiềm năng (MQL)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4A261;strokeColor=#4B5563;fontSize=11;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="930" y="620" width="300" height="66" as="geometry"/></mxCell><mxCell id="c43" value="fact_seller_monthly&#10;Hiệu suất seller · snapshot định kỳ&#10;1 seller × 1 tháng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4A261;strokeColor=#4B5563;fontSize=11;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="930" y="700" width="300" height="66" as="geometry"/></mxCell><mxCell id="c44" value="dim_date" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8ECAE6;strokeColor=#4B5563;fontSize=11;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="1360" y="620" width="400" height="30" as="geometry"/></mxCell><mxCell id="c45" value="dim_lead_origin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8ECAE6;strokeColor=#4B5563;fontSize=11;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="1360" y="658" width="400" height="30" as="geometry"/></mxCell><mxCell id="c46" value="dim_lead_profile" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8ECAE6;strokeColor=#4B5563;fontSize=11;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="1360" y="696" width="400" height="30" as="geometry"/></mxCell><mxCell id="c47" value="dim_sales_rep" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8ECAE6;strokeColor=#4B5563;fontSize=11;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="1360" y="734" width="400" height="30" as="geometry"/></mxCell><mxCell id="c48" value="dim_seller" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8ECAE6;strokeColor=#4B5563;fontSize=11;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="1360" y="772" width="400" height="30" as="geometry"/></mxCell><mxCell id="e49" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#6B7280;strokeWidth=1.0;" edge="1" parent="1" source="c42" target="c44"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e50" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#6B7280;strokeWidth=1.0;" edge="1" parent="1" source="c42" target="c45"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e51" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#6B7280;strokeWidth=1.0;" edge="1" parent="1" source="c42" target="c46"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e52" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#6B7280;strokeWidth=1.0;" edge="1" parent="1" source="c42" target="c47"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e53" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#6B7280;strokeWidth=1.0;" edge="1" parent="1" source="c42" target="c48"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e54" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#6B7280;strokeWidth=1.0;" edge="1" parent="1" source="c43" target="c44"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e55" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#6B7280;strokeWidth=1.0;" edge="1" parent="1" source="c43" target="c48"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c56" value="Câu hỏi phân tích:&#10;1. Kênh marketing nào chuyển MQL thành seller tốt nhất?&#10;2. Mất bao nhiêu ngày từ liên hệ đến chốt deal và đến đơn đầu?&#10;3. Seller từ funnel bán được bao nhiêu GMV?&#10;4. Seller nào ngừng bán sau khi chốt?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4B5563;fontSize=11;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="930" y="880" width="830" height="180" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>