<mxfile host="app.diagrams.net"><diagram name="Data model logic" id="d1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1750" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Data model logic: 6 quy trình (fact) nối với dimension và các cấp phân cấp (không ghi kiểu dữ liệu)" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=16;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1700" height="34" as="geometry"/></mxCell><mxCell id="c3" value="fact_order_item&#10;Bán hàng · transaction&#10;1 dòng hàng của 1 đơn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4A261;strokeColor=#4B5563;fontSize=11;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="330" height="100" as="geometry"/></mxCell><mxCell id="c4" value="fact_order_fulfillment&#10;Xử lý đơn · snapshot tích luỹ&#10;1 đơn, 5 mốc thời gian" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4A261;strokeColor=#4B5563;fontSize=11;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="200" width="330" height="100" as="geometry"/></mxCell><mxCell id="c5" value="fact_payment&#10;Thanh toán · transaction&#10;1 lần thanh toán" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4A261;strokeColor=#4B5563;fontSize=11;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="330" width="330" height="100" as="geometry"/></mxCell><mxCell id="c6" value="fact_review&#10;Đánh giá · transaction&#10;1 review của 1 đơn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4A261;strokeColor=#4B5563;fontSize=11;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="460" width="330" height="100" as="geometry"/></mxCell><mxCell id="c7" value="fact_lead_funnel&#10;Thu hút seller · snapshot tích luỹ&#10;1 khách tiềm năng (MQL)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4A261;strokeColor=#4B5563;fontSize=11;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="590" width="330" height="100" as="geometry"/></mxCell><mxCell id="c8" value="fact_seller_monthly&#10;Hiệu suất seller · snapshot định kỳ&#10;1 seller × 1 tháng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4A261;strokeColor=#4B5563;fontSize=11;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="720" width="330" height="100" as="geometry"/></mxCell><mxCell id="c9" value="dim_date&#10;Năm → Quý → Tháng → Ngày" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8ECAE6;strokeColor=#4B5563;fontSize=11;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="900" y="60" width="820" height="66" as="geometry"/></mxCell><mxCell id="c10" value="dim_geography&#10;Vùng → Bang → Thành phố → Zip" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8ECAE6;strokeColor=#4B5563;fontSize=11;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="900" y="140" width="820" height="66" as="geometry"/></mxCell><mxCell id="c11" value="dim_customer&#10;Vùng → Bang → Thành phố → Zip → Khách → Phiên bản (SCD2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8ECAE6;strokeColor=#4B5563;fontSize=11;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="900" y="220" width="820" height="66" as="geometry"/></mxCell><mxCell id="c12" value="dim_seller&#10;Vùng → Bang → Thành phố → Seller; Kênh → Origin → Seller" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8ECAE6;strokeColor=#4B5563;fontSize=11;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="900" y="300" width="820" height="66" as="geometry"/></mxCell><mxCell id="c13" value="dim_product&#10;Nhóm ngành → Danh mục → Sản phẩm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8ECAE6;strokeColor=#4B5563;fontSize=11;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="900" y="380" width="820" height="66" as="geometry"/></mxCell><mxCell id="c14" value="dim_order_status&#10;Nhóm trạng thái → Trạng thái" style="