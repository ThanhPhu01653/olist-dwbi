<mxfile host="app.diagrams.net"><diagram name="Data flow hiện trạng" id="d1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1800" pageHeight="880"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Luồng dữ liệu giữa các hệ thống CNTT hiện trạng (mũi tên ghi thông tin được truyền)" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=17;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1700" height="34" as="geometry"/></mxCell><mxCell id="c3" value="Khách hàng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4B5563;fontSize=12;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="150" height="80" as="geometry"/></mxCell><mxCell id="c4" value="Marketplace / kênh bán&#10;(sàn thương mại điện tử)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8ECAE6;strokeColor=#4B5563;fontSize=12;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="350" y="110" width="200" height="80" as="geometry"/></mxCell><mxCell id="c5" value="Hệ thống đơn hàng Olist&#10;(oltp: orders, order_items)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CDE8D6;strokeColor=#4B5563;fontSize=12;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="740" y="110" width="220" height="80" as="geometry"/></mxCell><mxCell id="c6" value="Người bán (seller)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4B5563;fontSize=12;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1130" y="110" width="180" height="80" as="geometry"/></mxCell><mxCell id="c7" value="Đơn vị vận chuyển" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4B5563;fontSize=12;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1130" y="330" width="200" height="80" as="geometry"/></mxCell><mxCell id="c8" value="Hệ thống thanh toán&#10;(oltp: order_payments)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CDE8D6;strokeColor=#4B5563;fontSize=12;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="350" y="360" width="200" height="80" as="geometry"/></mxCell><mxCell id="c9" value="Hệ thống đánh giá&#10;(oltp: order_reviews)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CDE8D6;strokeColor=#4B5563;fontSize=12;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="360" width="220" height="80" as="geometry"/></mxCell><mxCell id="c10" value="Dữ liệu địa chỉ&#10;(oltp: geolocation, customers, sellers)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CDE8D6;strokeColor=#4B5563;fontSize=12;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="740" y="360" width="240" height="80" as="geometry"/></mxCell><mxCell id="e11" value="thông tin đơn đặt (sản phẩm, số lượng, địa chỉ giao)" style="endArrow=classic;html=1;rounded=0;strokeColor=#374151;strokeWidth=1.6;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="thông tin đơn (người mua, dòng hàng, giá, phí vận chuyển)" style="endArrow=classic;html=1;rounded=0;strokeColor=#374151;strokeWidth=1.6;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="đơn cần chuẩn bị, hạn bàn giao" style="endArrow=classic;html=1;rounded=0;strokeColor=#374151;strokeWidth=1.6;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="kiện hàng bàn giao, thời điểm bàn giao" style="endArrow=classic;html=1;rounded=0;strokeColor=#374151;strokeWidth=1.6;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="trạng thái giao, ngày giao thực tế" style="endArrow=classic;html=1;rounded=0;strokeColor=#6B7280;strokeWidth=1.6;" edge="1" parent="1" source="c7" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" value="thông tin thanh toán (hình thức, số kỳ, số tiền)" style="endArrow=classic;html=1;rounded=0;strokeColor=#374151;strokeWidth=1.6;" edge="1" parent="1" source="c4" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17" value="xác nhận thanh toán, thời điểm duyệt đơn" style="endArrow=classic;html=1;rounded=0;strokeColor=#374151;strokeWidth=1.6;" edge="1" parent="1" source="c8" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e18" value="điểm đánh giá và nhận xét" style="endArrow=classic;html=1;rounded=0;strokeColor=#374151;strokeWidth=1.6;" edge="1" parent="1" source="c3" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e19" value="điểm review gắn với mã đơn" style="endArrow=classic;html=1;rounded=0;strokeColor=#374151;strokeWidth=1.6;" edge="1" parent="1" source="c9" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e20" value="toạ độ theo mã bưu chính" style="endArrow=classic;html=1;rounded=0;strokeColor=#374151;strokeWidth=1.6;" edge="1" parent="1" source="c10" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="Quy trình thu hút người bán (marketing funnel, hệ thống CRM)" style="rounded=0;verticalAlign=top;align=left;spacingLeft=8;dashed=1;whiteSpace=wrap;html=1;fillColor=#FFFBEA;strokeColor=#4B5563;fontSize=13;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="520" width="1700" height="340" as="geometry"/></mxCell><mxCell id="c22" value="Trang đích (landing page)&#10;và kênh marketing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8ECAE6;strokeColor=#4B5563;fontSize=12;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1480" y="590" width="220" height="80" as="geometry"/></mxCell><mxCell id="c23" value="CRM: khách tiềm năng&#10;(crm.mql)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CDE8D6;strokeColor=#4B5563;fontSize=12;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1190" y="590" width="200" height="80" as="geometry"/></mxCell><mxCell id="c24" value="Đội SDR&#10;(sàng lọc lead)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4B5563;fontSize=12;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="900" y="590" width="190" height="80" as="geometry"/></mxCell><mxCell id="c25" value="Đội SR&#10;(tư vấn, chốt deal)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4B5563;fontSize=12;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="610" y="590" width="190" height="80" as="geometry"/></mxCell><mxCell id="c26" value="CRM: thương vụ đã chốt&#10;(crm.closed_deals)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CDE8D6;strokeColor=#4B5563;fontSize=12;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="590" width="220" height="80" as="geometry"/></mxCell><mxCell id="e27" value="lead (kênh, ngày liên hệ)" style="endArrow=classic;html=1;rounded=0;strokeColor=#374151;strokeWidth=1.6;" edge="1" parent="1" source="c22" target="c23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e28" value="lead cần sàng lọc" style="endArrow=classic;html=1;rounded=0;strokeColor=#374151;strokeWidth=1.6;" edge="1" parent="1" source="c23" target="c24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e29" value="lead đã đủ điều kiện" style="endArrow=classic;html=1;rounded=0;strokeColor=#374151;strokeWidth=1.6;" edge="1" parent="1" source="c24" target="c25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e30" value="kết quả chốt" style="endArrow=classic;html=1;rounded=0;strokeColor=#374151;strokeWidth=1.6;" edge="1" parent="1" source="c25" target="c26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e31" value="seller mới (seller_id) được phép bán" style="endArrow=classic;html=1;rounded=0;strokeColor=#B45309;strokeWidth=1.6;" edge="1" parent="1" source="c26" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c32" value="Hai hệ thống nguồn độc lập: hệ thống bán hàng (oltp, 9 bảng) và CRM (crm, 2 bảng). Chỉ gặp nhau qua seller_id; không có khoá ngoại giữa hai hệ thống.&#10;Hiện trạng mỗi báo cáo lấy trực tiếp từ từng hệ thống nên số liệu khó đối chiếu; đây là lý do dựng kho dữ liệu." style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFFFFF;strokeColor=#4B5563;fontSize=12;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="50" y="740" width="1640" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>