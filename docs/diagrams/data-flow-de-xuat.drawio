<mxfile host="app.diagrams.net"><diagram name="Data flow đề xuất" id="d1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1500" pageHeight="600"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Luồng dữ liệu đề xuất: nguồn → staging → ODS → kho dữ liệu → data mart → BI" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=17;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1450" height="34" as="geometry"/></mxCell><mxCell id="c3" value="Nguồn&#10;oltp + crm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CDE8D6;strokeColor=#4B5563;fontSize=13;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="120" width="200" height="120" as="geometry"/></mxCell><mxCell id="c4" value="Staging&#10;stg_*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E5E7EB;strokeColor=#4B5563;fontSize=13;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="270" y="120" width="200" height="120" as="geometry"/></mxCell><mxCell id="c5" value="ODS&#10;làm sạch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E5E7EB;strokeColor=#4B5563;fontSize=13;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="520" y="120" width="200" height="120" as="geometry"/></mxCell><mxCell id="c6" value="Kho dữ liệu dw&#10;10 dim + 6 fact" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8ECAE6;strokeColor=#4B5563;fontSize=13;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="770" y="120" width="200" height="120" as="geometry"/></mxCell><mxCell id="c7" value="Data mart&#10;mart_* (17 view)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4A261;strokeColor=#4B5563;fontSize=13;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1020" y="120" width="200" height="120" as="geometry"/></mxCell><mxCell id="c8" value="BI&#10;Power BI, 7 dashboard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2D4F0;strokeColor=#4B5563;fontSize=13;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1270" y="120" width="200" height="120" as="geometry"/></mxCell><mxCell id="e9" value="bản sao thô + mã lô nạp" style="endArrow=classic;html=1;rounded=0;strokeColor=#374151;strokeWidth=1.6;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="dữ liệu sạch + cờ chất lượng, dòng lỗi có lý do" style="endArrow=classic;html=1;rounded=0;strokeColor=#374151;strokeWidth=1.6;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="dim (SCD1/SCD2) + fact (khoá thay thế)" style="endArrow=classic;html=1;rounded=0;strokeColor=#374151;strokeWidth=1.6;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="view tổng hợp theo chủ đề" style="endArrow=classic;html=1;rounded=0;strokeColor=#374151;strokeWidth=1.6;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="CSV / mô hình ngữ nghĩa, số đã tính sẵn" style="endArrow=classic;html=1;rounded=0;strokeColor=#374151;strokeWidth=1.6;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="Giám sát etl_log: job_run, rejected_rows, dq_check, watermark, batch_metrics (thông tin chạy: số dòng, thời gian, lỗi) → dashboard D7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3C4;strokeColor=#4B5563;fontSize=12;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="270" y="340" width="950" height="70" as="geometry"/></mxCell><mxCell id="e15" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#374151;strokeWidth=1.6;dashed=1;" edge="1" parent="1" source="c4" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#374151;strokeWidth=1.6;dashed=1;" edge="1" parent="1" source="c5" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#374151;strokeWidth=1.6;dashed=1;" edge="1" parent="1" source="c6" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e18" value="tình trạng ETL" style="endArrow=classic;html=1;rounded=0;strokeColor=#374151;strokeWidth=1.6;dashed=1;" edge="1" parent="1" source="c14" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="Điều phối: python -m etl.run_pipeline (một lệnh, ghi nhật ký từng bước) · Biến đổi: PostgreSQL procedure (PL/pgSQL) · Nạp tăng dần theo watermark, mỗi đợt khoảng 20 giây&#10;Nếu cần gần thời gian thực: thêm CDC + Kafka giữa nguồn và staging (chương 5)." style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFFFFF;strokeColor=#4B5563;fontSize=12;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="20" y="450" width="1450" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>