<mxfile host="app.diagrams.net"><diagram name="ERD OLTP" id="d1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1900" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="ERD hệ thống nguồn (oltp, crm): màu = nhóm dữ liệu; gạch chân = cột được dùng sang OLAP; đậm = khoá chính" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=16;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1850" height="34" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;oltp.customers&lt;/b&gt;&lt;hr size="1"/&gt;&lt;b&gt;&lt;u&gt;customer_id&lt;/u&gt;&lt;/b&gt;&lt;br/&gt;&lt;u&gt;customer_unique_id&lt;/u&gt;&lt;br/&gt;&lt;u&gt;customer_zip_code_prefix&lt;/u&gt;&lt;br/&gt;&lt;u&gt;customer_city&lt;/u&gt;&lt;br/&gt;&lt;u&gt;customer_state&lt;/u&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fillColor=#8ECAE6;strokeColor=#4B5563;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="300" height="121" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;oltp.orders&lt;/b&gt;&lt;hr size="1"/&gt;&lt;b&gt;&lt;u&gt;order_id&lt;/u&gt;&lt;/b&gt;&lt;br/&gt;&lt;u&gt;customer_id&lt;/u&gt;&lt;br/&gt;&lt;u&gt;order_status&lt;/u&gt;&lt;br/&gt;&lt;u&gt;order_purchase_timestamp&lt;/u&gt;&lt;br/&gt;&lt;u&gt;order_approved_at&lt;/u&gt;&lt;br/&gt;&lt;u&gt;order_delivered_carrier_date&lt;/u&gt;&lt;br/&gt;&lt;u&gt;order_delivered_customer_date&lt;/u&gt;&lt;br/&gt;&lt;u&gt;order_estimated_delivery_date&lt;/u&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fillColor=#F4A261;strokeColor=#4B5563;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="80" width="300" height="172" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;oltp.order_items&lt;/b&gt;&lt;hr size="1"/&gt;&lt;b&gt;&lt;u&gt;order_id&lt;/u&gt;&lt;/b&gt;&lt;br/&gt;&lt;b&gt;&lt;u&gt;order_item_id&lt;/u&g