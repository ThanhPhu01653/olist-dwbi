%% ERD of the two simulated source systems: oltp (sales) and crm (marketing).
%% Solid line = real foreign key in the database. Dotted line = logical link only (no FK).
%% Render: paste into https://mermaid.live or run  mmdc -i docs/erd_oltp.mmd -o figures/3-2-4_erd_oltp.png -s 2
erDiagram
    customers ||--o{ orders : "places (FK customer_id)"
    orders ||--o{ order_items : "contains (FK order_id)"
    orders ||--o{ order_payments : "paid by (FK order_id)"
    orders ||--o{ order_reviews : "reviewed in (FK order_id)"
    products ||--o{ order_items : "sold as (FK product_id)"
    sellers ||--o{ order_items : "sold by (FK seller_id)"

    customers }o..o{ geolocation : "zip prefix (logical, no FK)"
    sellers }o..o{ geolocation : "zip prefix (logical, no FK)"
    products }o..o| product_category_name_translation : "category name (logical, no FK: some categories have no translation)"

    sellers ||..o| crm_closed_deals : "seller_id (logical link across two systems, NO FK)"
    crm_mql ||--o| crm_closed_deals : "becomes (FK mql_id)"

    customers {
        char32 customer_id PK "one id per order"
        char32 customer_unique_id "real person"
        text customer_zip_code_prefix
        text customer_city
        text customer_state
    }
    orders {
        char32 order_id PK
        char32 customer_id FK
        text order_status
        timestamp order_purchase_timestamp
        timestamp order_approved_at
        timestamp order_delivered_carrier_date
        timestamp order_delivered_customer_date
        timestamp order_estimated_delivery_date
    }
    order_items {
        char32 order_id PK, FK
        int order_item_id PK
        char32 product_id FK
        char32 seller_id FK
        timestamp shipping_limit_date
        numeric price
        numeric freight_value
    }
    order_payments {
        char32 order_id PK, FK
        int payment_sequential PK
        text payment_type
        int payment_installments
        numeric payment_value
    }
    order_reviews {
        char32 review_id PK "repeats across orders"
        char32 order_id PK, FK
        smallint review_score
        text review_comment_title
        text review_comment_message
        timestamp review_creation_date
        timestamp review_answer_timestamp
    }
    products {
        char32 product_id PK
        text product_category_name
        int product_name_lenght "misspelt in source"
        int product_description_lenght "misspelt in source"
        int product_photos_qty
        int product_weight_g
        int product_length_cm
        int product_height_cm
        int product_width_cm
    }
    sellers {
        char32 seller_id PK
        text seller_zip_code_prefix
        text seller_city
        text seller_state
    }
    geolocation {
        bigint id PK "technical key, no natural key"
        text geolocation_zip_code_prefix
        double geolocation_lat
        double geolocation_lng
        text geolocation_city
        text geolocation_state
    }
    product_category_name_translation {
        text product_category_name PK
        text product_category_name_english
    }
    crm_mql {
        char32 mql_id PK
        date first_contact_date
        char32 landing_page_id
        text origin
    }
    crm_closed_deals {
        char32 mql_id PK, FK
        char32 seller_id UK "no FK to sellers"
        char32 sdr_id
        char32 sr_id
        timestamp won_date
        text business_segment
        text lead_type
        text lead_behaviour_profile
        boolean has_company
        boolean has_gtin
        text average_stock
        text business_type
        numeric declared_product_catalog_size
        numeric declared_monthly_revenue
    }
